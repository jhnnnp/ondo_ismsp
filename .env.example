# PII_TOOLKIT_API_HOST=127.0.0.1
# PII_TOOLKIT_API_PORT=8000
# PII_TOOLKIT_RELOAD=0
# PII_TOOLKIT_ENABLE_DEMO=1
# Swagger UI. Unset on Vercel production (hidden). Set 1 to force-enable locally.
# PII_TOOLKIT_ENABLE_DOCS=1
# AI full report generation (optional). Without a key, the rule-based report remains.
# The rule engine owns readiness, gaps, N/A, causality, and review cards.
# POST /controls/report recomputes checklist facts server-side before calling the LLM.
# OPENAI_API_KEY=
# PII_TOOLKIT_OPENAI_API_KEY=
# PII_TOOLKIT_OPENAI_BASE_URL=https://api.openai.com/v1
# PII_TOOLKIT_OPENAI_MODEL=gpt-4o-mini
# PII_TOOLKIT_OPENAI_TIMEOUT=45
# PII_TOOLKIT_LLM_REPORTS_PER_MINUTE=6
# PII_TOOLKIT_LLM_REPORT_MAX_CONCURRENT=2
# AI report usage pass. Issue with: python -m isms_pii_toolkit.access_pass issue --days 7
# PII_TOOLKIT_ACCESS_PASS_REQUIRED=1
# Workspace UI gate. Independent from the AI report switch above.
# Local UI work without an invite: PII_TOOLKIT_WORKSPACE_PASS_REQUIRED=0
# PII_TOOLKIT_WORKSPACE_PASS_REQUIRED=1
# PII_TOOLKIT_ACCESS_PASS_STORE=
# On Vercel, leave PII_TOOLKIT_ACCESS_PASS_STORE empty and use BLOB_READ_WRITE_TOKEN.
# BLOB_READ_WRITE_TOKEN=
# Hidden admin console. Both values are required. Do not use /admin or other guessable names.
# Path must be one URL segment, 12-64 chars: letters, digits, _ or -.
# Example URL: https://www.jhpis.me/<PII_TOOLKIT_ADMIN_PATH>
# PII_TOOLKIT_ADMIN_PATH=
# PII_TOOLKIT_ADMIN_PASSWORD=
# Detail narratives (official_kb RAG chunks + facts-only LLM). Off → template from official_kb.
# PII_TOOLKIT_LLM_DETAIL_NARRATIVES=1
# PII_TOOLKIT_LLM_DETAIL_MAX_CONTROLS=8

# 국가법령정보 공유서비스 동기화(선택). 실제 키는 .env에만 두고 커밋하지 않습니다.
# 공공데이터포털의 디코딩 인증키를 사용합니다. URL에 직접 기록하지 마세요.
# DATA_GO_KR_SERVICE_KEY=
# LAW_OPEN_API_BASE_URL=https://apis.data.go.kr/1170000/law
# LAW_API_TIMEOUT_SECONDS=10
# LAW_API_MAX_RETRIES=3
